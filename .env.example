# Environment
APP_ENV=dev

# Local Ollama runtime
OLLAMA_HOST=http://127.0.0.1:11434
GENERATION_MODEL=qwen3:8b
REVIEW_MODEL=qwen3:14b
ENABLE_REVIEW_MODEL=false
EMBEDDING_MODEL=nomic-embed-text:latest
RAG_TOP_K=5

# Browser safety
# Headed mode is mandatory. Runtime validation must reject true.
BROWSER_HEADLESS=false
TARGET_APPLICATION_URL=https://www.bluein.green/jobs/games-qa-qc-lead/apply/

# Local storage
ARTIFACT_ROOT=artifacts
CHROMA_PATH=.local/chroma
CANDIDATE_DATA_PATH=data/candidate
JOB_DATA_PATH=data/jobs/bluein-green-games-qa-qc-lead

# Optional local input. Leave blank in this committed template.
# Set only in your untracked .env.
SOURCE_RESUME_PATH=

# Safety controls
ALLOW_FILL=false
ALLOW_RESUME_UPLOAD=false
ALLOW_SUBMIT=false

# Local client timeouts
REQUEST_TIMEOUT_SECONDS=120
